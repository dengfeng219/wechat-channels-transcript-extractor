# ═══════════════════════════════════════════════════════════
#  本机隐私 —— 绝对不要提交（含你的腾讯元宝登录态 / 提取记录）
# ═══════════════════════════════════════════════════════════
config.json
history.json

# 一键登录用的独立浏览器配置目录（内含登录 Cookie）
.browser_profile_*/
.browser_profile_*/*

# ═══════════════════════════════════════════════════════════
#  运行时产生的数据（每个人跑出来都不一样）
# ═══════════════════════════════════════════════════════════
output/
uploads/
recordings/

# ═══════════════════════════════════════════════════════════
#  依赖与模型：体积大，按 README 首次运行自动安装
# ═══════════════════════════════════════════════════════════
.venv/
venv/
models/
wheels/

# ═══════════════════════════════════════════════════════════
#  Python 缓存 / 生成物
# ═══════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*.egg-info/
jieba.cache
wxt_check.js

# ═══════════════════════════════════════════════════════════
#  测试产物（可重跑生成）
#    注意：tests/wx_decrypted.mp4 是 test_decrypt.py 的输出，
#    但 test_web_flow.py / test_batch_history.py 会读它，
#    所以跑那两个测试前请先跑一次 test_decrypt.py。
#    tests/wx_encrypted.mp4 是真实加密样本，属于必要测试数据，保留。
# ═══════════════════════════════════════════════════════════
tests/e2e_output/
tests/integration_output/
tests/*_output/
tests/wx_decrypted.mp4
*.log

# ═══════════════════════════════════════════════════════════
#  编辑器 / 系统
# ═══════════════════════════════════════════════════════════
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
